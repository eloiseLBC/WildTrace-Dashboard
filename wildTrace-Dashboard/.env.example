# Server-only configuration. Copy this file to .env in this directory.
OCI_NAMESPACE=
OCI_DAILY_BUCKET=
# Leave empty for documents at the bucket root; otherwise use their exact prefix.
OCI_DAILY_PREFIX=
OCI_CONFIG_PROFILE=DEFAULT
# Leave empty for the SDK default ~/.oci/config.
# Relative paths resolve from wildTrace-Dashboard; ~/ is supported.
OCI_CONFIG_FILE=
