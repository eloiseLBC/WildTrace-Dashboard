# Application configuration; OCI entries are server-only. Copy this file to .env in this directory.
OCI_NAMESPACE=
OCI_DAILY_BUCKET=
# Exact non-empty prefix containing consolidated daily documents (usually ending in /).
OCI_DAILY_PREFIX=
OCI_CONFIG_PROFILE=DEFAULT
# Leave empty for the SDK default ~/.oci/config.
# Relative paths resolve from wildTrace-Dashboard; ~/ is supported.
OCI_CONFIG_FILE=

# API server settings. Comma-separated origins are allowed if needed.
PORT=3001
CORS_ORIGIN=http://localhost:5173
DAILY_CACHE_TTL_SECONDS=60
OCI_DOWNLOAD_CONCURRENCY=5
INSIGHTS_MIN_SLEEP_NIGHTS=5
# Optional public API URL. Local Vite defaults to http://localhost:3001.
# In production, empty means same-origin /api.
# VITE_API_BASE_URL=http://localhost:3001
